{
  "name": "kana-kanji-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "data:download": "node data-pipeline/download.mjs",
    "data:kana": "node data-pipeline/build-kana.mjs",
    "data:kanji": "node data-pipeline/build-kanji.mjs",
    "data:words": "node data-pipeline/build-words.mjs",
    "data:strokes": "node data-pipeline/build-strokes.mjs",
    "data:index": "node data-pipeline/build-index.mjs",
    "data:check-strokes": "node data-pipeline/check-strokes.mjs",
    "build:data": "npm run data:download && npm run data:kana && npm run data:kanji && npm run data:words && npm run data:strokes && npm run data:index && npm run data:check-strokes",
    "assets:icons": "node data-pipeline/generate-icons.mjs",
    "sync:apk": "node data-pipeline/copy-apk.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@tailwindcss/vite": "^4.3.3",
    "hanzi-writer": "^3.7.3",
    "hanzi-writer-data-jp": "^0.0.2",
    "idb-keyval": "^6.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "fake-indexeddb": "^6.2.5",
    "fast-xml-parser": "^5.10.1",
    "oxlint": "^1.71.0",
    "qrcode": "^1.5.4",
    "sax": "^1.6.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
